# Copy to .env and fill in. Never commit .env.

# --- Data source: synthea | athena ---
ADAPTER=synthea
SYNTHEA_DATA_DIR=data/synthea

# Required only when ADAPTER=athena
ATHENA_BASE_URL=
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=

# --- Local LLMs (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
AGENT_MODEL=llama3.1:8b
JUDGE_MODEL=qwen2.5:7b
# Seconds to wait for one LLM call (raise on low-memory machines)
OLLAMA_TIMEOUT_SECONDS=600

# --- Salesforce (Developer Edition org) ---
SF_USERNAME=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Your org's My Domain, e.g. acme-dev-ed.develop.my.salesforce.com (".salesforce.com" and
# "https://" are optional). The client credentials flow does not work with login/test.
SF_DOMAIN=

# --- Deadlines ---
# IANA time zone for business-day math; holidays are listed in the YAML file
PRACTICE_TIMEZONE=America/Chicago
HOLIDAYS_FILE=library/holidays.yaml

# --- Pipeline ---
# ER visit + admission within this gap (hours) = one discharge episode
ER_ADMIT_MERGE_WINDOW_HOURS=6
RETRY_DIR=data/retry
LOG_LEVEL=INFO
