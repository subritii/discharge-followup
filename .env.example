# Copy to .env and fill in. Never commit .env.

# --- Data source: synthea | athena ---
ADAPTER=synthea
SYNTHEA_DATA_DIR=data/synthea

# Required only when ADAPTER=athena
ATHENA_BASE_URL=
ATHENA_CLIENT_ID=
ATHENA_CLIENT_SECRET=

# --- Local LLMs (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
AGENT_MODEL=llama3.1:8b
JUDGE_MODEL=qwen2.5:7b

# --- Salesforce (Developer Edition org) ---
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=
# "login" for Developer Edition / production, "test" for sandboxes
SF_DOMAIN=login

# --- Pipeline ---
RETRY_DIR=data/retry
LOG_LEVEL=INFO
